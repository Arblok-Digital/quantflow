# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ===== JEV (System One decision model) — decision chip server-side =====
# Chain keputusan: Jev(opencode gateway keyless) → Jev(zen) → Jev(openrouter)
# → Gemini → Keel. Kosongkan semua → chain langsung ke Gemini/Keel.
#
# JALUR KEYLESS (disarankan, TANPA API key):
# Model `opencode/*` diproksi GATEWAY opencode (auth built-in CLI). Slug
# default TERBUKTI hidup via `npm run jev:probe` (2026-09-21) → "opencode/ling-3.0-flash-fin-free".
# (Slug lama "opencode/jev-1.13-free" mati sisi-cloud: "Unexpected server error"
# konsisten — jangan dipakai lagi.) Adapter memanggil CLI `opencode run -m ...`
# di work dir temp.
#   OPENCODE_MODEL:     slug model (default "opencode/ling-3.0-flash-fin-free")
#   OPENCODE_BIN:       path binary explisit (default: auto-resolve npm global)
#   OPENCODE_WORK_DIR:  dir kerja aman (default <tmp>/quantflow-opencode-gw)
OPENCODE_MODEL="opencode/ling-3.0-flash-fin-free"
OPENCODE_BIN=""
OPENCODE_WORK_DIR=""

# JEV_ZEN_BASE_URL: base URL chat-completions opencode zen (tanpa "/chat/completions")
# JEV_ZEN_API_KEY:  key opencode zen
# JEV_ZEN_MODEL:    slug model (default "opencode/jev-1.13-free" — id terverifikasi)
JEV_ZEN_BASE_URL=""
JEV_ZEN_API_KEY=""
JEV_ZEN_MODEL="opencode/jev-1.13-free"

# OPENROUTER_BASE_URL/KEY/MODEL: fallback kedua Jev lewat OpenRouter.
# SLUG TIDAK DIJAMIN: slug persis "typesafe/jev-1.13" harus diverifikasi
# (npm run jev:probe) — OpenRouter menyediakan keluarga Jev via search page.
# JANGAN pernah menulis key sungguhan di file ini (file ini DI-COMMIT).
# Isi key hanya di `.env` lokal / Secrets panel.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_PASSCODE: passcode untuk login panel (fallback default: "paper-local").
# Ganti dengan passcode kuat untuk server yang terbuka ke publik.
AUTH_PASSCODE=""

# ===== BROKER (ccxt) - REAL TRADING CONNECTOR =====
# TRADING_MODE: "paper" (default, dry-run - simulasi realistis di atas harga asli) | "live" (order exchange asli)
# LIVE TRADING HANYA AKTIF kalau TRADING_MODE=live DAN API key terisi.
TRADING_MODE="paper"

# BROKER_EXCHANGE: id exchange ccxt (binance, bybit, okx, kraken, dll)
BROKER_EXCHANGE="binance"

# API key/secret dari exchange (WAJIB untuk mode live; opsional untuk paper)
BROKER_API_KEY=""
BROKER_API_SECRET=""

# BROKER_TESTNET: true = pakai sandbox/testnet exchange (bybit/okx support)
BROKER_TESTNET="false"

# BROKER_EVENT_SECRET: HMAC secret untuk signature order server-side (payload
# sha256 + HMAC pada setiap receipt order). Fallback dev: "paper-dev-secret".
# WAJIB diganti dengan secret kuat sebelum mode live.
BROKER_EVENT_SECRET=""

# ===== PAPER MODE (training config) =====
# PAPER_INITIAL_CASH: modal awal akun paper (default 10000)
PAPER_INITIAL_CASH="10000"
# PAPER_LEVERAGE_MAX: leverage maksimum yang diterima server (default 50)
PAPER_LEVERAGE_MAX="50"
# PAPER_FEE_TAKER_BPS / PAPER_FEE_MAKER_BPS: tarif fee dalam basis point
# (default 4 bps = 0.04% taker, 2 bps = 0.02% maker — tarif Binance USDT-M VIP0)
PAPER_FEE_TAKER_BPS="4"
PAPER_FEE_MAKER_BPS="2"

# ===== PRE-TRADE RISK GATE (matematis, fail-closed) =====
# Gate ini berlaku di CHOKE POINT eksekusi (src/paperbook/fill.ts untuk semua
# order paper + src/broker/liveBroker.ts untuk live) sehingga TIDAK bisa
# di-bypass lewat jalur manual/POST /api/broker/order.
#   RISK_MAX_PER_TRADE_PCT : risiko riil (jarak SL × notional) max sbg % equity (default 1.0)
#   RISK_MAX_NOTIONAL_PCT  : notional max sbg % equity (default 25)
#   RISK_MIN_RR            : reward/risk minimum (default 1.5)
#   RISK_MIN_STOP_PCT      : jarak SL minimum sbg % harga — lantai anti-noise (default 0.35)
#   RISK_GATE_ENABLED      : "true" (default) | "false"/"0"/"off" untuk eksperimen terkontrol
# Contoh: SL 0.8% / TP 1.2% (RR 1.5) dengan size 12% equity → risiko 0.096% equity, lolos.
# Contoh ditolak: SL 0.08% (di dalam noise) atau RR 1.28 (di bawah minimum).
RISK_MAX_PER_TRADE_PCT="1.0"
RISK_MAX_NOTIONAL_PCT="25"
RISK_MIN_RR="1.5"
RISK_MIN_STOP_PCT="0.35"
RISK_GATE_ENABLED="true"

# ===== SIZING (F2 — satu satuan) =====
# Satuan sizing resmi di seluruh sistem: % equity sebagai NOTIONAL posisi
# (bukan margin) — sama dengan satuan risk gate di atas (risiko riil =
# jarak SL × notional). Margin = notional / leverage; leverage tidak
# mengubah ukuran. Engine Keel: size risk-targeted 0.5% equity/trade
# (budget.maxRiskPct), di-cap notional 5% equity
# (RISK_CONSTANTS.MAX_POSITION_SIZE_PCT); gate size Keel kini CAP-ONLY
# (size < 2% dari band lama BOLEH untuk SL lebar). Panel manual:
# "Size %" = % equity notional; tooltip FE sudah sesuai.

# ===== GUARDRAILS (order-level) =====
# GUARD_KILL_SWITCH: true = blokir semua order (darurat).
# GUARD_MAX_OPEN_POSITIONS: maksimum posisi terbuka (default 5).
# GUARD_MAX_DAILY_LOSS_PERCENT: stop loss harian (default 10%).
# GUARD_MIN_ORDER_INTERVAL_MS: cooldown antar order dalam ms (default 30000).
# Master toggle `guardsEnabled` default ON untuk paper & live (.guardrails.json);
# matikan eksplisit lewat panel Guardrails / POST /api/broker/guards bila perlu.
GUARD_KILL_SWITCH="false"
GUARD_MAX_OPEN_POSITIONS="5"
GUARD_MAX_DAILY_LOSS_PERCENT="10"
GUARD_MIN_ORDER_INTERVAL_MS="30000"
